<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Arc.Crypto</PackageId>
    <Authors>archi-Doc</Authors>
    <Product>Arc.Crypto</Product>
    <Description>Arc.Crypto is a library equipped with various features related to cryptography.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/archi-Doc/Arc.Crypto</PackageProjectUrl>
    <RepositoryUrl>https://github.com/archi-Doc/Arc.Crypto</RepositoryUrl>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\stylecop.json" Link="stylecop.json" />
  </ItemGroup>

  <ItemGroup>
    <!--Lets the test project reach the per-backend AEGIS implementations, so the portable
        software path can be cross-checked against the hardware path on a machine where only
        the hardware path would otherwise ever run.-->
    <InternalsVisibleTo Include="Test" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="runtimes\**\*">
      <PackagePath>%(Identity)</PackagePath>
      <Pack>true</Pack>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <ArcCryptoNativeRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</ArcCryptoNativeRid>
    <ArcCryptoNativeRid Condition="'$(ArcCryptoNativeRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</ArcCryptoNativeRid>
  </PropertyGroup>

  <ItemGroup>
    <!-- Flow the selected native asset through project references as well as NuGet packages. -->
    <Content Update="runtimes\$(ArcCryptoNativeRid)\native\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Arc.Collections" Version="1.45.0" />
    <PackageReference Include="libsodium" Version="1.0.22" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
